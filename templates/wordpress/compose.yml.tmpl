# Stack WordPress cô lập - sinh bởi lat. Site __DOMAIN__ (id __ID__).
# 4 container: web(nginx) + php(wordpress:fpm) + db(mariadb) + redis. Chỉ web join latvps_proxy.
# Giá trị ${...} đọc từ .env của site (docker compose interpolate). VIRTUAL_HOST/LE_* để nginx-proxy + acme-companion.
# BẢO MẬT: TUYỆT ĐỐI KHÔNG thêm 'ports:' cho db/redis/php - chúng chỉ ở network 'internal'
# (db/redis không bao giờ lộ ra host/internet). lat tự kiểm tra điều này sau khi tạo site.
#
# cpus: chặn 1 site ngốn hết CPU làm chậm mọi site khác (bot cào, plugin loop vô hạn).
# Đây là GIỚI HẠN TRẦN, không phải đặt chỗ - site nhàn rỗi không bị thiệt gì.
#
# healthcheck: chỉ đặt cho db + redis (hai service mà "chết âm thầm" là hỏng thật, và lệnh
# kiểm tra chắc chắn có trong image). LƯU Ý: Docker thường KHÔNG tự restart container
# unhealthy - healthcheck ở đây để `lat status` / `docker ps` nhìn ra ngay, thay vì site 500
# cả đêm mà container vẫn hiện "running". Chưa nối vào depends_on: service_healthy vì việc đó
# đổi hành vi khởi động, cần test trên VPS thật trước.
name: site-__ID__

services:
  db:
    image: mariadb:11
    container_name: __ID___db
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: wordpress
      MARIADB_USER: wordpress
      MARIADB_PASSWORD: ${DB_PASSWORD}
      MARIADB_RANDOM_ROOT_PASSWORD: "1"
    volumes:
      - db:/var/lib/mysql
    networks: [ internal ]
    security_opt: [ "no-new-privileges:true" ]
    mem_limit: 512m
    cpus: "1.0"
    healthcheck:
      # healthcheck.sh do chính image mariadb ship sẵn (/usr/local/bin).
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s

  redis:
    image: redis:7-alpine
    container_name: __ID___redis
    restart: unless-stopped
    command: ["redis-server","--requirepass","${REDIS_PASSWORD}","--maxmemory","64mb","--maxmemory-policy","allkeys-lru"]
    volumes:
      - redis:/data
    networks: [ internal ]
    security_opt: [ "no-new-privileges:true" ]
    mem_limit: 96m
    cpus: "0.5"
    healthcheck:
      # Mật khẩu đã nằm trong command: của chính service này nên không lộ thêm gì mới.
      test: ["CMD-SHELL", "redis-cli -a '${REDIS_PASSWORD}' --no-auth-warning ping | grep -q PONG"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 15s

  php:
    image: wordpress:fpm-alpine
    container_name: __ID___php
    restart: unless-stopped
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: ${DB_PASSWORD}
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_REDIS_HOST','redis');
        define('WP_REDIS_PORT',6379);
        define('WP_REDIS_PASSWORD','${REDIS_PASSWORD}');
        define('FS_METHOD','direct');
    volumes:
      - wphtml:/var/www/html
      - ./wp-content:/var/www/html/wp-content
    networks: [ internal ]
    depends_on: [ db, redis ]
    security_opt: [ "no-new-privileges:true" ]
    mem_limit: 512m
    cpus: "1.0"

  web:
    image: nginx:alpine
    container_name: __ID___web
    restart: unless-stopped
    environment:
      VIRTUAL_HOST: ${VIRTUAL_HOST}
      LETSENCRYPT_HOST: ${LE_HOST:-}
      LETSENCRYPT_EMAIL: ${LE_EMAIL:-}
    volumes:
      - wphtml:/var/www/html:ro
      - ./wp-content:/var/www/html/wp-content:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    networks: [ internal, proxy ]
    depends_on: [ php ]
    security_opt: [ "no-new-privileges:true" ]
    mem_limit: 128m
    cpus: "0.5"

networks:
  internal:
  proxy:
    external: true
    name: latvps_proxy

volumes:
  db:
  redis:
  wphtml:
